# Stashive example environment
#
# Exact names may evolve during bootstrap. Keep this file synchronized with code.

STASHIVE_DATA_DIR=./data
DATABASE_URL=sqlite:///./data/stashive.db
APP_ENVIRONMENT=development
AUTH_COOKIE_SECURE=false
AUTH_SESSION_LIFETIME_HOURS=168
AUTH_SETUP_TOKEN_LIFETIME_MINUTES=60

# Future provider credentials belong here when provider support is implemented.
# Do not add real secrets to this file.
